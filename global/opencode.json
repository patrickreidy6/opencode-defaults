{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "agents": {
    "title": {
      "model": "openai/gpt-6.1-sol#medium"
    },
    "explore": {
      "model": "openai/gpt-6-astra#medium"
    },
    "general": {
      "model": "openai/gpt-6-astra#high"
    },
    "xm-planner": {
      "description": "Write repository implementation plans for the opt-in /xm-plan-write command",
      "mode": "primary",
      "model": "anthropic/claude-fable-5-2#high",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "docs/plans/*.md", "effect": "allow" },
        { "action": "edit", "resource": "docs/superpowers/plans/*.md", "effect": "allow" },
        { "action": "edit", "resource": "docs/plans/archive/*", "effect": "deny" },
        { "action": "edit", "resource": "docs/superpowers/plans/archive/*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "experimental_image_generate", "resource": "*", "effect": "deny" }
      ]
    },
    "xm-reviewer": {
      "description": "Return independent findings for the opt-in /xm-* review commands",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "experimental_image_generate", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff --no-ext-diff --no-textconv *", "effect": "allow" },
        { "action": "shell", "resource": "git log --oneline *", "effect": "allow" },
        { "action": "shell", "resource": "git show --no-ext-diff --no-textconv *", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
        { "action": "shell", "resource": "git hash-object -- *", "effect": "allow" },
        { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
        { "action": "shell", "resource": "git symbolic-ref *", "effect": "allow" }
      ]
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#22f0b463e7a5e579904dd6211a520321035526f7"
  ],
  "instructions": [
    "~/.config/opencode/AGENTS.local.md"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  }
}
